{
  "name": "trust-layer-agent",
  "version": "0.0.1",
  "description": "A small trust layer for customer-facing agents: tools gated by checks in code, replies that can't claim what no tool confirmed, and need-to-know customer data.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sim": {
      "types": "./dist/sim/simulator.d.ts",
      "import": "./dist/sim/simulator.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "smoke": "npm run build && node --env-file=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
