{
  "name": "trust-layer-agent",
  "version": "0.2.0",
  "description": "A simple framework for guardrails on agents: gate tool calls, check replies, and measure both with a built-in simulation and grading setup.",
  "keywords": [
    "ai",
    "agents",
    "guardrails",
    "trust",
    "human-in-the-loop",
    "operations",
    "llm",
    "evals",
    "simulation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmt99e/trust-layer-agent.git"
  },
  "homepage": "https://github.com/rmt99e/trust-layer-agent#readme",
  "bugs": {
    "url": "https://github.com/rmt99e/trust-layer-agent/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sim": {
      "types": "./dist/sim/simulator.d.ts",
      "import": "./dist/sim/simulator.js"
    },
    "./postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "import": "./dist/stores/postgres.js"
    },
    "./testing": {
      "types": "./dist/sim/scripted.d.ts",
      "import": "./dist/sim/scripted.js"
    }
  },
  "bin": {
    "trust-layer-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "smoke": "npm run build && node --env-file=.env scripts/smoke.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
