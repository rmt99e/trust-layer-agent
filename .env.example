# One of these, for the model you use. The CLI loads this file from the current directory.
ANTHROPIC_API_KEY=
# For the openai-compatible adapter: OPENAI_BASE_URL is optional for a hosted API, OPENAI_API_KEY is optional for localhost.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional, for `npm run smoke`: which model each provider's smoke run uses (defaults in scripts/smoke.mjs).
SMOKE_ANTHROPIC_MODEL=
SMOKE_OPENAI_MODEL=
SMOKE_OLLAMA_MODEL=
